{
  // ecmel.vscode-html-css extension settings for CSS and SCSS files
  "css.styleSheets": [
    "app/assets/stylesheets/**/*.{css,scss}",
    "app/assets/builds/**/*.css",
    "https://cdn.boxicons.com/3.0.8/fonts/basic/boxicons.min.css",
    "https://cdn.boxicons.com/3.0.8/fonts/filled/boxicons-filled.min.css",
    "https://cdn.boxicons.com/3.0.8/fonts/brands/boxicons-brands.min.css"
  ],
  // this extension does not parse Ruby expressions embedded inside ERB HTML attributes.
  "css.autoValidation": "Save",

  "files.associations": {
    "**/case_narrative.conf": "nginx"
  },

  // Force the VS Code Prettier extension to use this project's configuration.
  // Its HTML override leaves <style> content to Stylelint.
  "prettier.configPath": "prettier.config.js",
  // Use the same local Prettier version as `bun run format`; plugins are only
  // supported by the extension when it loads a local or global Prettier module.
  "prettier.prettierPath": "./node_modules/prettier",
  "prettier.requireConfig": true,

  // Run the workspace-installed module, keeping editor and CLI versions aligned.
  // Explicitly select the ESM config instead of relying on parent-directory lookup.
  "stylelint.stylelintPath": "./node_modules/stylelint",
  "stylelint.configFile": "./stylelint.config.mjs",
  "stylelint.validate": ["css", "scss"],
  "stylelint.lintFiles.glob": "**/*.{css,scss}",

  // Show Herb diagnostics while keeping automatic template fixes disabled.
  "languageServerHerb.linter.enabled": true,
  "languageServerHerb.linter.fixOnSave": false,
  "languageServerHerb.trace.server": "off",

  // Apply assists before formatting the extension's temporary document. The
  // wrapper also selects the bundled erbfmt with the Ruby pinned in mise.toml.
  "erbfmt.command": "bin/erbfmt-vscode",
  "erbfmt.arguments": [],
  "erbfmt.configPath": "erbfmt.json",
  // Publish erbfmt diagnostics in the Problems panel on file open and save.
  "erbfmt.lint.enabled": true
}
