{
  "name": "app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun bun.config.js",
    "lint": "eslint .",
    "lint:css": "stylelint \"app/assets/stylesheets/**/*.{css,scss}\"",
    "lint:fix": "eslint . --fix && stylelint \"app/assets/stylesheets/**/*.{css,scss}\" --fix",
    "build:css": "sass ./app/assets/stylesheets/application.bootstrap.scss:./app/assets/builds/application.css --source-map --embed-sources --load-path=node_modules --quiet-deps",
    "watch:css": "sass app/assets/stylesheets/application.bootstrap.scss:app/assets/builds/application.css --style=expanded --load-path=node_modules --source-map --embed-sources --quiet-deps --watch",
    "clean": "rm -f app/assets/builds/application.js app/assets/builds/application.js.map app/assets/builds/application.css app/assets/builds/application.css.map"
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.23",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "moment": "^2.31.0",
    "nodemon": "^3.1.14",
    "sass": "^1.105.1"
  },
  "browserslist": [
    "defaults"
  ],
  "devDependencies": {
    "@awmottaz/prettier-plugin-void-html": "^2.3.0",
    "@eslint/js": "^10.0.1",
    "@prettier/plugin-ruby": "^4.0.4",
    "@stylistic/stylelint-config": "^5.0.0",
    "@stylistic/stylelint-plugin": "^5.3.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "prettier-plugin-erb": "^0.4.0",
    "stylelint": "^17.16.0",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-no-indistinguishable-colors": "^2.3.1",
    "stylelint-order": "^8.1.1"
  }
}
