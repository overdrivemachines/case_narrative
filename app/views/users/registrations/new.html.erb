<% content_for :title, "Create your account · Case Narrative" %>
<% content_for :devise_top_link do %>
  <div class="devise-switch-link">
    <span>Already registered?</span>
    <%= link_to new_session_path(resource_name), class: "btn btn-auth-outline" do %>
      Sign In
      <svg viewBox="0 0 11 11" aria-hidden="true"><path d="M.75 9.94 9.94.75M3.19.75h6.75V7.5" /></svg>
    <% end %>
  </div>
<% end %>

<section class="devise-card devise-card-registration" aria-labelledby="sign-up-title">
  <header class="devise-card-header">
    <span class="devise-card-kicker">Get started</span>
    <h2 id="sign-up-title">Create your account</h2>
    <p>Bring your facts, evidence, and documents together in one clear workspace.</p>
  </header>

  <%= render "users/shared/error_messages", resource: resource %>

  <%= form_for(
    resource,
    as: resource_name,
    url: registration_path(resource_name),
    html: {
      class: "devise-form needs-validation",
      novalidate: true,
      data: { controller: "auth-form", action: "submit->auth-form#submit", auth_form_submitting_label_value: "Creating account" }
    }
  ) do |f| %>
    <div class="devise-field">
      <%= f.label :name, "Full Name" %>
      <div class="devise-input-wrap">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" /></svg>
        <%= f.text_field :name, autofocus: true, autocomplete: "name", placeholder: "Your Full Name", required: true, minlength: resource_class::NAME_MINIMUM_LENGTH, maxlength: resource_class::NAME_MAXIMUM_LENGTH, class: [ "form-control", ("is-invalid" if resource.errors.include?(:name)) ], aria: { invalid: resource.errors.include?(:name) } %>
      </div>
      <div class="invalid-feedback"><%= resource.errors.full_messages_for(:name).first || "Name must be between #{resource_class::NAME_MINIMUM_LENGTH} and #{resource_class::NAME_MAXIMUM_LENGTH} characters." %></div>
    </div>

    <div class="devise-field">
      <%= f.label :email %>
      <div class="devise-input-wrap">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
        <%= f.email_field :email, autocomplete: "email", placeholder: "you@example.com", required: true, class: [ "form-control", ("is-invalid" if resource.errors.include?(:email)) ], aria: { invalid: resource.errors.include?(:email) } %>
      </div>
      <div class="invalid-feedback"><%= resource.errors.full_messages_for(:email).first || "Enter a valid email address." %></div>
    </div>

    <div class="devise-field">
      <div class="devise-field-row">
        <%= f.label :password %>
        <% if @minimum_password_length %><span class="devise-field-hint"><%= @minimum_password_length %> characters minimum</span><% end %>
      </div>
      <div class="devise-input-wrap devise-input-wrap-password">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="11" width="18" height="10" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
        <%= f.password_field :password, autocomplete: "new-password", placeholder: "Create a password", required: true, minlength: @minimum_password_length, class: [ "form-control", ("is-invalid" if resource.errors.include?(:password)) ], aria: { invalid: resource.errors.include?(:password) } %>
        <button class="devise-password-toggle" type="button" aria-label="Show password" aria-pressed="false" data-action="auth-form#togglePassword">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z" /><circle cx="12" cy="12" r="2.5" /></svg>
        </button>
      </div>
      <div class="invalid-feedback"><%= resource.errors.full_messages_for(:password).first || "Create a password that meets the minimum length." %></div>
    </div>

    <div class="devise-field">
      <%= f.label :password_confirmation, "Confirm Password" %>
      <div class="devise-input-wrap devise-input-wrap-password">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="11" width="18" height="10" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "Enter it again", required: true, minlength: @minimum_password_length, class: [ "form-control", ("is-invalid" if resource.errors.include?(:password_confirmation)) ], aria: { invalid: resource.errors.include?(:password_confirmation) } %>
        <button class="devise-password-toggle" type="button" aria-label="Show password" aria-pressed="false" data-action="auth-form#togglePassword">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z" /><circle cx="12" cy="12" r="2.5" /></svg>
        </button>
      </div>
      <div class="invalid-feedback"><%= resource.errors.full_messages_for(:password_confirmation).first || "Confirm your password." %></div>
    </div>

    <%= f.button class: "btn btn-primary-action", data: { auth_form_target: "submit" } do %>
      <span data-auth-form-target="submitLabel">Create Account</span>
      <svg viewBox="0 0 11 11" aria-hidden="true"><path d="M.75 9.94 9.94.75M3.19.75h6.75V7.5" /></svg>
      <span class="btn-loading-spinner" aria-hidden="true"></span>
    <% end %>
  <% end %>

  <%= render "users/shared/social_sign_in" %>
  <p class="devise-terms">By creating an account, you agree to use Case Narrative responsibly and keep your account secure.</p>
</section>
