<%# locals: (resource:) %>
<% if resource.errors.any? %>
  <div class="devise-message devise-message-alert devise-error-summary" role="alert" data-turbo-temporary>
    <p>Please review the highlighted fields.</p>
    <ul class="mb-0">
      <% resource.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
