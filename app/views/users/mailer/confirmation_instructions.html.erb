<% content_for :email_preheader, "Confirm your email to finish setting up Case Narrative." %>
<p class="email-kicker">Welcome to Case Narrative</p>
<h1 class="email-title">Confirm your email</h1>
<p class="email-copy email-copy-strong">Hello <%= @resource.name.presence || @email %>,</p>
<p class="email-copy">You're one step away from bringing your facts, evidence, and documents together. Confirm your email address to activate your account.</p>

<%= render "users/mailer/action", label: "Confirm My Account", url: confirmation_url(@resource, confirmation_token: @token) %>

<p class="email-note">If you didn't create a Case Narrative account, you can safely ignore this email.</p>
