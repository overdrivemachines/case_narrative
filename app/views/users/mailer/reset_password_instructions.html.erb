<% content_for :email_preheader, "Use this secure link to reset your Case Narrative password." %>
<p class="email-kicker">Account recovery</p>
<h1 class="email-title">Reset your password</h1>
<p class="email-copy email-copy-strong">Hello <%= @resource.name.presence || @resource.email %>,</p>
<p class="email-copy">We received a request to reset the password for your Case Narrative account. Use the secure link below to choose a new one.</p>

<%= render "users/mailer/action", label: "Choose a New Password", url: edit_password_url(@resource, reset_password_token: @token) %>

<p class="email-note">If you didn't request a password reset, ignore this email. Your password will remain unchanged until you use the link and create a new one.</p>
