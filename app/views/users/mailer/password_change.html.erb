<% content_for :email_preheader, "The password for your Case Narrative account was changed." %>
<p class="email-kicker">Security notice</p>
<h1 class="email-title">Password changed</h1>
<p class="email-copy email-copy-strong">Hello <%= @resource.name.presence || @resource.email %>,</p>
<p class="email-copy">The password for your Case Narrative account was changed successfully.</p>
<p class="email-note">If you made this change, no further action is needed. If you didn't, reset your password immediately and review access to your email account.</p>
