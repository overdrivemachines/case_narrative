<%# Header contains logo, navigation links, and sign-in and sign-up %>
<%# Called by: app/views/layouts/home.html.erb %>
<header class="home-header">
  <div class="cn-shell">
    <div class="home-topbar">
      <span>A clearer way to build your case</span>
      <span class="d-none d-md-inline">Securely organize events, evidence, and documents</span>
    </div>

    <nav class="home-nav navbar navbar-expand-lg" aria-label="Home page navigation">
      <div class="container-fluid px-0">
        <%= link_to root_path, class: "home-brand" do %>
          <%= image_tag "home/logo.png", width: 32, height: 30, alt: "" %>
          <span>Case Narrative</span>
        <% end %>

        <button
          class="navbar-toggler home-menu-button"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#home-navigation"
          aria-controls="home-navigation"
          aria-expanded="false"
          aria-label="Toggle navigation"
        >
          <span></span><span></span>
        </button>

        <div id="home-navigation" class="collapse navbar-collapse">
          <ul class="navbar-nav mx-auto">
            <% { "Home" => "#home", "Timeline" => "#timeline", "Legal drafting" => "#documents", "How it works" => "#process" }.each do |label, destination| %>
              <li class="nav-item">
                <%= link_to destination, class: "nav-link" do %>
                  <span class="link-swap"><span><%= label %></span><span aria-hidden="true"><%= label %></span></span>
                <% end %>
              </li>
            <% end %>
          </ul>

          <div class="home-nav-actions">
            <% if user_signed_in? %>
              <%= link_to "Dashboard", dashboard_path, class: "home-nav-text-link" %>
              <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "home-nav-text-link" %>
            <% else %>
              <%= link_to "Sign In", new_user_session_path, class: "home-nav-text-link" %>
              <%= link_to new_user_registration_path, class: "btn btn-brand-primary home-nav-primary" do %>
                <span>Create Account</span><i class="icon-arrow-up-right" aria-hidden="true"></i>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    </nav>
  </div>
</header>
