<!DOCTYPE html>
<html lang="en">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="color-scheme" content="dark">
    <meta name="supported-color-schemes" content="dark">
    <%= stylesheet_link_tag "mailer", media: "all" %>
  </head>

  <body>
    <div class="email-preheader"><%= content_for?(:email_preheader) ? yield(:email_preheader) : "A message from Case Narrative" %></div>
    <table class="email-page" role="presentation" width="100%">
      <tr>
        <td align="center">
          <table class="email-shell" role="presentation" width="100%">
            <tr>
              <td class="email-header">
                <%= link_to root_url, class: "email-brand" do %>
                  <table role="presentation">
                    <tr>
                      <%# TODO: Replace this temporary image host with a casenarrative.com URL. %>
                      <td><%= image_tag "https://i.ibb.co/wFn4R2HY/logo.png", class: "email-brand-logo", width: 38, alt: "Case Narrative" %></td>
                      <td width="12"></td>
                      <td>Case Narrative</td>
                    </tr>
                  </table>
                <% end %>
              </td>
            </tr>
            <tr>
              <td class="email-card"><%= yield %></td>
            </tr>
            <tr>
              <td class="email-footer">
                &copy; <%= Time.current.year %> Case Narrative<br>
                Organize the facts. Connect the evidence. Tell the story clearly.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
