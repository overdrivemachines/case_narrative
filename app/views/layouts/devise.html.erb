<!DOCTYPE html>
<html lang="en">
  <head>
    <%= render "layouts/document_head", default_title: "Account · Case Narrative" %>
  </head>

  <body class="devise-page" data-bs-theme="dark">
    <div class="devise-shell">
      <%= render "users/shared/auth_aside" %>
      <main class="devise-main">
        <div class="devise-main-top">
          <%= link_to safe_back_path, class: "devise-back-link" do %>
            <span class="devise-back-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7" /></svg>
            </span>
            <span>Back</span>
          <% end %>
          <%= yield :devise_top_link %>
        </div>
        <%= yield %>
      </main>
    </div>
  </body>
</html>
